<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Background="{DynamicResource AppBackground}">
        <Grid.RowDefinitions>
            <RowDefinition Height="64"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="34"/>
        </Grid.RowDefinitions>

        <!-- Top Studio Bar -->
        <Border Background="{DynamicResource TopBackground}" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1">
            <DockPanel Margin="22,0,18,0" LastChildFill="False">
                <!-- Brand Lockup -->
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center" Margin="0,0,16,0">
                    <Image x:Name="BrandMark" Width="30" Height="30" RenderOptions.BitmapScalingMode="HighQuality"/>
                    <Rectangle x:Name="BrandWordmark" Width="84" Height="24" Margin="9,0,0,0" Fill="{DynamicResource TextMain}" AutomationProperties.Name="Lacuna"/>
                    <Border Width="1" Height="20" Background="{DynamicResource Line}" Margin="18,0,4,0" Opacity="0.75"/>
                </StackPanel>

                <!-- Primary Navigation Tabs -->
                <StackPanel x:Name="Navigation" DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center"/>

                <!-- Right Utility & Status Cluster -->
                <Button x:Name="Exit" DockPanel.Dock="Right" Content="退出" Style="{StaticResource GhostButton}"
                        VerticalAlignment="Center" Margin="8,0,0,0" Padding="12,6" ToolTip="保存进度并退出 Lacuna"/>
                <Button x:Name="CodexShortcut" DockPanel.Dock="Right" Content="Codex · 待检测"
                        VerticalAlignment="Center" Padding="12,6" MinHeight="34" Margin="8,0,0,0"/>
                <Border x:Name="ProjectHeaderChip" Cursor="Hand" Focusable="True" DockPanel.Dock="Right" Background="{DynamicResource Panel}"
                        BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="14"
                        Padding="12,5" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="10,0,2,0" MaxWidth="260">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse x:Name="ProjectDot" Width="7" Height="7" Fill="{DynamicResource Accent}" Margin="0,0,7,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="ProjectHeader" VerticalAlignment="Center" FontSize="12.5"
                                   Foreground="{DynamicResource TextMuted}" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </Border>
            </DockPanel>
        </Border>

        <!-- 7-Stage Pipeline Stepper Rail -->
        <Border x:Name="PipelineBar" Grid.Row="1" Padding="22,8" Background="{DynamicResource SideBackground}"
                BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" Visibility="Collapsed">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                <StackPanel x:Name="StageRail" Orientation="Horizontal" VerticalAlignment="Center"/>
            </ScrollViewer>
        </Border>

        <!-- Main Workspace Content Canvas -->
        <ScrollViewer Grid.Row="2" MaxHeight="150" VerticalScrollBarVisibility="Auto"><StackPanel x:Name="ProjectNotices"/></ScrollViewer>
        <DockPanel Grid.Row="3">
            <ContentControl x:Name="PageFooter" DockPanel.Dock="Bottom" HorizontalContentAlignment="Stretch" Visibility="Collapsed"/>
            <ScrollViewer x:Name="WorkspaceScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          Padding="28,22,28,28">
                <StackPanel x:Name="Workspace" MaxWidth="1320" HorizontalAlignment="Stretch"/>
            </ScrollViewer>
        </DockPanel>

        <!-- Live Studio Status Bar -->
        <Border Grid.Row="4" Background="{DynamicResource TopBackground}" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0">
            <DockPanel Margin="22,0">
                <Border DockPanel.Dock="Right" Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Line}"
                        BorderThickness="1" CornerRadius="10" Padding="8,2" VerticalAlignment="Center" Margin="14,0,0,0">
                    <TextBlock x:Name="Version" FontSize="11.5" FontFamily="Consolas, Microsoft YaHei UI"
                               VerticalAlignment="Center" Foreground="{DynamicResource AccentText}"/>
                </Border>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse x:Name="StatusDot" Width="7" Height="7" Fill="{DynamicResource Accent}"
                             Margin="0,0,9,0" VerticalAlignment="Center" Opacity="0.7"/>
                    <TextBlock x:Name="Status" VerticalAlignment="Center" FontSize="12.5"
                               TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextMuted}"/>
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
