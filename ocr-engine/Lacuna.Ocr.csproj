<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Version>0.1.62</Version>
    <AssemblyVersion>0.1.62.0</AssemblyVersion>
    <FileVersion>0.1.62.0</FileVersion>
    <InformationalVersion>0.1.62.0</InformationalVersion>
    <OutputType>Exe</OutputType>
    <AssemblyName>Lacuna.Ocr</AssemblyName>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishTrimmed>true</PublishTrimmed>
    <TrimMode>partial</TrimMode>
    <InvariantGlobalization>true</InvariantGlobalization>
    <PublishSingleFile>true</PublishSingleFile>
    <DebugType>none</DebugType>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="OpenCvSharp4" Version="4.13.0.20261107" />
    <PackageReference Include="OpenCvSharp4.runtime.win.slim" Version="4.13.0.20261107" />
    <PackageReference Include="Clipper2" Version="1.5.4" />
    <PackageReference Include="Microsoft.ML.OnnxRuntime.Managed" Version="1.23.2" />
  </ItemGroup>
</Project>